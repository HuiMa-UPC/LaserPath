    <qresource prefix="/fonts">
        <file alias="MiSans_Bold">fonts/MiSans-Bold.otf</file>
        <file alias="MiSans_Medium">fonts/MiSans-Medium.otf</file>
        <file alias="MiSans_Regular">fonts/MiSans-Regular.otf</file>
    </qresource>
</RCC>
