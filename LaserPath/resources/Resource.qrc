        <file alias="undo">icons/titleBar/titleBar_undo.svg</file>
        <file alias="sep">icons/titleBar/titleBar_line.svg</file>
        <file alias="menu">icons/titleBar/titleBar_dropDown.svg</file>
        <file alias="redo">icons/titleBar/titleBar_redo.svg</file>
        <file alias="close">icons/titleBar/titleBar_close.svg</file>
        <file alias="max">icons/titleBar/titleBar_max.svg</file>
        <file alias="min">icons/titleBar/titleBar_min.svg</file>
        <file alias="restore">icons/titleBar/titleBar_window.svg</file>
        <file alias="prepare">icons/topBar/tab_prepare.svg</file>
        <file alias="preview">icons/topBar/tab_preview.svg</file>
        <file alias="reset">icons/sideBarPanel/sideBarPanel_undo.svg</file>
        <file alias="device">icons/sideBarPanel/sideBarPanel_device.svg</file>
        <file alias="edit">icons/sideBarPanel/edit_btn.svg</file>
        <file alias="image">icons/sideBarPanel/device_image.png</file>
        <file alias="arrow">icons/sideBarPanel/machine_dropDown.svg</file>
        <file alias="wire">icons/sideBarPanel/line_width.svg</file>
        <file alias="settings">icons/sideBarPanel/machine_settings.svg</file>
        <file alias="sideBar_save">icons/sideBarPanel/sideBar_save.svg</file>
        <file alias="process">icons/sideBarPanel/sideBar_process.svg</file>
        <file alias="layerHeight">icons/sideBarPanel/sideBar_layerHeight.svg</file>
        <file alias="checkmark">icons/checkmark.svg</file>
        <file alias="precision">icons/sideBarPanel/sideBar_precision.svg</file>
        <file alias="wall">icons/sideBarPanel/sideBar_wall.svg</file>
        <file alias="infill">icons/sideBarPanel/sideBar_infill.svg</file>
        <file alias="checkmark_green">icons/checkmark_green.svg</file>
        <file alias="copy">icons/sideBarPanel/sideBar_copy.svg</file>
        <file alias="nameEdit">icons/sideBarPanel/sideBar_edit.svg</file>
        <file alias="delete">icons/sideBarPanel/sideBar_delete.svg</file>
        <file alias="more">icons/sideBarPanel/sideBar_more.svg</file>
        <file alias="add">icons/sideBarPanel/sideBar_add.svg</file>
        <file alias="info">icons/sideBarPanel/sideBar_info.svg</file>
        <file alias="cogPage">icons/sideBarPanel/sideBar_cogPage.svg</file>
        <file alias="speed">icons/sideBarPanel/sideBar_speed.svg</file>
        <file alias="notes">icons/sideBarPanel/sideBar_notes.svg</file>
